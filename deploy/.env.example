# PostgreSQL
S3MIGRATE_DATABASE_URL=postgres://migrate:migrate@localhost:5432/migrateproxy?sslmode=disable

# Master key used for encrypting stored upstream secrets (reference implementation)
S3MIGRATE_MASTER_KEY=change-this-to-a-256-bit-secret

# Source provider (e.g., b2, r2, wasabi, aws, generic)
S3MIGRATE_SOURCE_PROVIDER=generic
S3MIGRATE_SOURCE_ENDPOINT=http://localhost:9000
S3MIGRATE_SOURCE_REGION=us-east-1
S3MIGRATE_SOURCE_BUCKET=sourcebucket
S3MIGRATE_SOURCE_ACCESS_KEY_ID=minioadmin
S3MIGRATE_SOURCE_SECRET_ACCESS_KEY=minioadmin
S3MIGRATE_SOURCE_PATH_STYLE=true
S3MIGRATE_SOURCE_TLS_SKIP_VERIFY=false

# Destination provider
S3MIGRATE_DEST_PROVIDER=generic
S3MIGRATE_DEST_ENDPOINT=http://localhost:9010
S3MIGRATE_DEST_REGION=us-east-1
S3MIGRATE_DEST_BUCKET=destbucket
S3MIGRATE_DEST_ACCESS_KEY_ID=minioadmin
S3MIGRATE_DEST_SECRET_ACCESS_KEY=minioadmin
S3MIGRATE_DEST_PATH_STYLE=true
S3MIGRATE_DEST_TLS_SKIP_VERIFY=false

# Gateway listener
S3MIGRATE_GATEWAY_LISTEN_ADDR=:8080
# Admin API defaults to localhost only for safety. Only bind to 0.0.0.0 if you
# have a TLS-terminating reverse proxy or load balancer in front of it.
S3MIGRATE_ADMIN_LISTEN_ADDR=127.0.0.1:8081
S3MIGRATE_ADMIN_API_KEY_HASH=change-this-to-a-long-random-admin-key

# Worker
S3MIGRATE_WORKER_ENABLE=true
S3MIGRATE_WORKER_MAX_CONCURRENT_TASKS=10
S3MIGRATE_WORKER_TRANSFER_PART_SIZE=67108864

# Metrics
S3MIGRATE_METRICS_ENABLE=true
S3MIGRATE_METRICS_METRICS_ADDR=0.0.0.0:9090
